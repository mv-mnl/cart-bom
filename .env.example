# Servidor (apps/server)
PORT=2567
# Cuánto se le guarda el asiento a quien se desconecta a media partida (segundos).
ESPERA_RECONEXION_S=60
# Pausa antes de cada jugada de la computadora en línea (milisegundos).
PAUSA_COMPU_MS=1200

# Cliente (apps/client). Vacío: el mismo host de la página en el puerto 2567.
VITE_SERVIDOR=

# docker compose: puertos en la máquina anfitriona.
PUERTO_CLIENTE=8080
PUERTO_SERVIDOR=2567
